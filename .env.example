# Supabase — Werte aus dem Supabase-Dashboard: Project Settings -> API
# In Vercel für ALLE drei Umgebungen (Production, Preview, Development) hinterlegen.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwendet (Invites, Admin-Aktionen). Niemals mit NEXT_PUBLIC_ Prefix versehen.
SUPABASE_SERVICE_ROLE_KEY=

# Basis-URL der App, für Passwort-Setzen-/Invite-Links (z. B. https://plattform.desk-revolution.de)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP (hallo@desk-revolution.de) — folgt in Abschnitt 2.2 des Kickoffs
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hallo@desk-revolution.de
